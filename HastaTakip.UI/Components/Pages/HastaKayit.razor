@page "/hastalar/yeni"
@inject HastaTakip.UI.Services.LoginStateService LoginState
@using System.Net
@using HastaTakip.UI.Dtos
@using HastaTakip.UI.Services
@using MudBlazor
@inject HastaApi Api
@inject NavigationManager Nav
@rendermode InteractiveServer


@if (showSuccess)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;z-index:1000;">
        <div style="background:#fff;padding:24px 32px;border-radius:12px;max-width:340px;text-align:center;">
            <h4 style="margin:0 0 12px 0;">Kayıt tamamlandı ✅</h4>
            <button class="btn-blue" @onclick="GotoList">Tamam</button>
        </div>
    </div>
}


@if (showError)
{
    <div style="position:fixed;inset:0;background:rgba(0,0,0,.4);display:flex;align-items:center;justify-content:center;z-index:1000;">
        <div style="background:#fff;padding:24px 32px;border-radius:12px;max-width:380px;text-align:center;">
            <h4 style="margin:0 0 12px 0;">Uyarı / Hata ❌</h4>
            <p style="margin:0 0 16px 0;">@error</p>
            <button class="btn-blue" @onclick="CloseError">Tamam</button>
        </div>
    </div>
}

    <MudText Typo="Typo.h4" Class="mb-4">
        Yeni Hasta Kaydı
    </MudText>

<div class="form-page">

    <!-- 1) HASTA -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">

        <MudText Typo="Typo.h6" Class="mb-4">
            1) Hasta
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">

                <MudTextField @bind-Value="hasta.TcKimlikNo"
                              Label="TCKN"
                              MaxLength="11"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>
            <MudItem xs="12" sm="6" md="4">

                <MudTextField @bind-Value="hasta.Ad"
                              Label="Ad"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>

            <MudItem xs="12" sm="6" md="4">

                <MudTextField @bind-Value="hasta.Soyad"
                              Label="Soyad"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>

            <MudItem xs="12" sm="6" md="4">

                <MudSelect T="string"
                           @bind-Value="hasta.Cinsiyet"
                           Label="Cinsiyet"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense">

                    <MudSelectItem T="string" Value="@("")">Seçiniz</MudSelectItem>
                    <MudSelectItem T="string" Value="@("E")">Erkek</MudSelectItem>
                    <MudSelectItem T="string" Value="@("K")">Kadın</MudSelectItem>

                </MudSelect>

            </MudItem>
            <MudItem xs="12" sm="6" md="4">

                <MudDatePicker @bind-Date="hasta.BirthDate"
                               Label="Doğum Tarihi"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               DateFormat="dd.MM.yyyy" />

            </MudItem>
            <MudItem xs="12" sm="6" md="4">

                <MudTextField @bind-Value="hasta.Telefon"
                              Label="Telefon"
                              Placeholder="05xx..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>

            <MudItem xs="12" sm="6" md="4">

                <MudTextField @bind-Value="hasta.Email"
                              Label="E-posta"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>
            <MudItem xs="12">

                <MudTextField @bind-Value="hasta.Adres"
                              Label="Adres"
                              Lines="2"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- 2) AİLE ÜYELERİ -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">

        <MudText Typo="Typo.h6" Class="mb-4">
        2) Aile Üyeleri (opsiyonel)
        </MudText>
        <MudGrid>
            <MudItem xs="12" sm="6" md="4">

                <MudTextField @bind-Value="aileForm.Iliski"
                              Label="İlişki"
                              Placeholder="Anne/Baba/Kardeş..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>
            <MudItem xs="12" sm="6" md="4">

                <MudTextField @bind-Value="aileForm.Ad"
                              Label="Ad"
                              Placeholder="İsim"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker Label="Doğum"
                               Date="@aileForm.DogumTarihi"
                               DateChanged="@(d => aileForm.DogumTarihi = d)"
                               DateFormat="dd.MM.yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">

                <MudNumericField T="decimal?"
                                 @bind-Value="aileForm.BoyCm"
                                 Label="Boy (cm)"
                                 Step="0.1M"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />

            </MudItem>

            <MudItem xs="12" sm="6" md="4">

                <MudNumericField T="decimal?"
                                 @bind-Value="aileForm.AgirlikKg"
                                 Label="Kilo (kg)"
                                 Step="0.1M"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense" />

            </MudItem>

            <MudItem xs="12">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="AileEkle"
                           Disabled="@(string.IsNullOrWhiteSpace(aileForm.Iliski)
                                                      || string.IsNullOrWhiteSpace(aileForm.Ad)
                                                      || aileForm.DogumTarihi == null)">
                    Ekle
                </MudButton>

            </MudItem>

            <MudItem xs="12" md="8">

                <MudTextField @bind-Value="aileForm.SaglikDurumu"
                              Label="Sağlık Durumu"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>

            <MudItem xs="12" md="4">

                <MudTextField @bind-Value="aileForm.Meslek"
                              Label="Meslek"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />

            </MudItem>
        </MudGrid>

        @if (aileUyeleri.Count > 0)
        {
            <MudStack Spacing="2" Class="mt-4">

                @foreach (var au in aileUyeleri.Select((x, i) => new { x, i }))
                {
                    <MudPaper Class="pa-3" Elevation="0" Outlined="true">

                        <MudStack Row="true"
                                  AlignItems="AlignItems.Center"
                                  Justify="Justify.SpaceBetween">

                            <MudText>

                                <b>@au.x.Iliski</b> —
                                @au.x.Ad
                                (@(au.x.DogumTarihi?.ToString("dd.MM.yyyy") ?? "-"))

                            </MudText>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => AileSil(au.i))">
                                Sil
                            </MudButton>

                        </MudStack>

                    </MudPaper>
                }

            </MudStack>
        }
    </MudPaper>

    <!-- 3) ÖYKÜLER -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">

        <MudText Typo="Typo.h6" Class="mb-4">
            3) Öyküler (opsiyonel)
        </MudText>

        <MudGrid>

            <MudItem xs="12">
                <MudTextField @bind-Value="oyku.Yakinmalar"
                              Label="Yakınmalar"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="oyku.Oykusu"
                              Label="Öyküsü"
                              Lines="3"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.GebelikOykusu" Label="Gebelik Öyküsü" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.DogumSekli" Label="Doğum Şekli" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.DogumAgirlik" Label="Doğum Ağırlığı" Placeholder="örn: 3200 gr" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.DogumBoyu" Label="Doğum Boyu" Placeholder="örn: 50 cm" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.NeonatalDonem" Label="Neonatal Dönem" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.NorGelisim" Label="Nör. Gelişim" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.SutcocukBeslenme" Label="Süt / Çocuk Beslenme" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.GecirilenHast" Label="Geçirilen Hastalıklar" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.OperasyonKaza" Label="Operasyon / Kaza" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.KanAkrabaligi" Label="Kan Akrabalığı" Placeholder="örn: Yok / 1. derece kuzen evliliği" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.KardesSagligi" Label="Kardeş Sağlığı" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="oyku.AileHastaliklar" Label="Aile Hastalıkları" Variant="Variant.Outlined" Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker Label="Oluşturma Tarihi"
                               Date="@oyku.OlusturmaTarihi"
                               DateChanged="@(d => oyku.OlusturmaTarihi = d)"
                               DateFormat="dd.MM.yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true" />
            </MudItem>
        </MudGrid>

    </MudPaper>

    @* Sections 4-7: only visible to doctors *@
    @if (LoginState.IsDoctor)
    {
        <!-- 4) BESLENME / ALIŞKANLIKLAR -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">

            <MudText Typo="Typo.h6" Class="mb-4">
                4) Beslenme / Alışkanlıklar (opsiyonel)
            </MudText>

            <MudGrid>

                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="Tarih"
                                   Date="@diyetForm.Tarih"
                                   DateChanged="@(d => diyetForm.Tarih = d ?? DateTime.Today)"
                                   DateFormat="dd.MM.yyyy"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="false" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.Ekmek" Label="Ekmek" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.Tahil" Label="Tahıl" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.Et" Label="Et" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.Peynir" Label="Peynir" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.Sut" Label="Süt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.Yogurt" Label="Yoğurt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.Meyve" Label="Meyve" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.Sebze" Label="Sebze" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.SiviGida" Label="Şekerli İçecek" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.AburCubur" Label="Abur Cubur" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudTextField @bind-Value="diyetForm.EkranSuresi" Label="Ekran Süresi" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(diyetForm.Tarih == default)"
                               OnClick="DiyetEkle">
                        Ekle
                    </MudButton>
                </MudItem>

            </MudGrid>

            @if (diyetler.Count > 0)
            {
                <MudStack Spacing="2" Class="mt-4">

                    @foreach (var d in diyetler.Select((x, i) => new { x, i }))
                    {
                        <MudPaper Class="pa-3" Elevation="0" Outlined="true">

                            <MudStack Row="true"
                                      AlignItems="AlignItems.Center"
                                      Justify="Justify.SpaceBetween">

                                <MudText>
                                    <b>@(d.x.Tarih == default ? "-" : d.x.Tarih.ToString("dd.MM.yyyy"))</b>
                                    — Ekmek:@d.x.Ekmek, Tahıl:@d.x.Tahil, Et:@d.x.Et, Peynir:@d.x.Peynir,
                                    Süt:@d.x.Sut, Yoğurt:@d.x.Yogurt, Meyve:@d.x.Meyve, Sebze:@d.x.Sebze,
                                    Şekerli İçecek:@d.x.SiviGida, Abur Cubur:@d.x.AburCubur, Ekran Süresi:@d.x.EkranSuresi
                                </MudText>

                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => DiyetSil(d.i))">
                                    Sil
                                </MudButton>

                            </MudStack>

                        </MudPaper>
                    }

                </MudStack>
            }

        </MudPaper>

        <!-- 5) ZİYARET + ANTROPOMETRİ -->
        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">

            <MudText Typo="Typo.h6" Class="mb-4">
                5) İlk Ziyaret + Antropometri (opsiyonel)
            </MudText>

            <MudGrid>

                <MudItem xs="12" sm="6" md="4">
                    <MudDatePicker Label="Ziyaret Tarihi"
                                   Date="@ilkZiyaretTarihi"
                                   DateChanged="@(d => ilkZiyaretTarihi = d ?? DateTime.Today)"
                                   DateFormat="dd.MM.yyyy"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="false" />
                </MudItem>

                <MudItem xs="12" sm="6" md="8">
                    <MudTextField @bind-Value="ilkZiyaretNotu"
                                  Label="Not"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?"
                                     @bind-Value="boy"
                                     Label="Boy (cm)"
                                     Step="0.1M"
                                     Min="30M"
                                     Max="220M"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?"
                                     @bind-Value="kilo"
                                     Label="Kilo (kg)"
                                     Step="0.1M"
                                     Min="1M"
                                     Max="200M"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?"
                                     @bind-Value="basCevresi"
                                     Label="Baş Çev. (cm)"
                                     Step="0.1M"
                                     Min="25M"
                                     Max="65M"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="3">
                    <MudNumericField T="decimal?"
                                     @bind-Value="oturmaBoyuCm"
                                     Label="Oturma Boyu (cm)"
                                     Step="0.1M"
                                     Min="20M"
                                     Max="140M"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>

            </MudGrid>

        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">

            <MudText Typo="Typo.h6" Class="mb-4">
                6) PuberteFizik & YorumPlan (opsiyonel)
            </MudText>

            <MudGrid>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="pf.PuberteNotu"
                                  Label="Puberte Notu"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="pf.PatolojikFizik"
                                  Label="Patolojik Fizik"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="yp.TedaviBeslenmeSpor"
                                  Label="Tedavi/Beslenme/Spor"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="yp.YorumNotlar"
                                  Label="Yorum Notlar"
                                  Lines="3"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudDatePicker Label="Oluşturma Tarihi"
                                   Date="@yp.OlusturmaTarihi"
                                   DateChanged="@(d => yp.OlusturmaTarihi = d)"
                                   DateFormat="dd.MM.yyyy"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Clearable="true" />
                </MudItem>

            </MudGrid>

        </MudPaper>

        <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">

            <MudText Typo="Typo.h6" Class="mb-4">
                7) Klinik Özet (opsiyonel)
            </MudText>

            <MudGrid>

                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField T="decimal?"
                                     @bind-Value="ozet.KulacCm"
                                     Label="Kulaç (cm)"
                                     Step="0.1M"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" sm="6" md="4">
                    <MudNumericField T="decimal?"
                                     @bind-Value="ozet.HedefBoyCm"
                                     Label="Hedef Boy (cm)"
                                     Step="0.1M"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="ozet.BoyaUyanTarti"
                                  Label="Boya Uyan Tartı"
                                  MaxLength="50"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>

            </MudGrid>

        </MudPaper>
    }

    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Size="Size.Large"
                   Disabled="@busy"
                   OnClick="Kaydet">
            Kaydet
        </MudButton>

        @if (busy)
        {
            <MudProgressCircular Size="Size.Small"
                                 Color="Color.Primary"
                                 Indeterminate="true" />

            <MudText Color="Color.Secondary">
                Kaydediliyor…
            </MudText>
        }

    </MudStack>
</div>

@code {
    // --- State ---
    string? error, success; bool busy;
    bool showSuccess;
    bool showError;

    void GotoList()
    {
        showSuccess = false;
        Nav.NavigateTo("/hastalar");
    }

    void CloseError()
    {
        showError = false;
    }

    void ShowError(string message)
    {
        error = message;
        showError = true;
    }

    // 1) Hasta
    PatientCreateDto hasta = new();

    // 2) Aile üyeleri
    List<AileUyesiCreateDto> aileUyeleri = new();
    AileUyesiCreateDto aileForm = new();

    // 3) Öyküler (tek)
    OykulerCreateDto oyku = new();

    // 4) Diyetler
    List<DiyetCreateDto> diyetler = new();
    DiyetCreateDto diyetForm = new() { Tarih = DateTime.Today };

    // 5) Ziyaret + Antropometri
    DateTime ilkZiyaretTarihi = DateTime.Today;
    string? ilkZiyaretNotu;
    decimal? boy, kilo, basCevresi, oturmaBoyuCm;

    // 6) PuberteFizik + YorumPlan
    PuberteFizikCreateDto pf = new();
    YorumPlanCreateDto yp = new()
    {
        OlusturmaTarihi = DateTime.Today
    };

    // 7) Klinik Özet
    OzetHesapCreateDto ozet = new();

    protected override async Task OnInitializedAsync()
    {
        if (!LoginState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        try { await Api.HealthAsync(); }
        catch { ShowError("API bağlantısı kurulamadı."); }
    }

    void AileEkle()
    {
        if (string.IsNullOrWhiteSpace(aileForm.Iliski) || string.IsNullOrWhiteSpace(aileForm.Ad))
        { ShowError("Aile üyesi için İlişki ve Ad zorunludur."); return; }

        aileUyeleri.Add(aileForm);
        aileForm = new(); error = null;
    }
    void AileSil(int i) => aileUyeleri.RemoveAt(i);

    void DiyetEkle()
    {
        if (diyetForm.Tarih == default) { ShowError("Diyet için tarih zorunludur."); return; }
        diyetler.Add(diyetForm);
        diyetForm = new() { Tarih = DateTime.Today }; error = null;
    }
    void DiyetSil(int i) => diyetler.RemoveAt(i);

    async Task Kaydet()
    {
        error = success = null;
        showError = false;

        if (oturmaBoyuCm.HasValue && (oturmaBoyuCm < 20 || oturmaBoyuCm > 140))
        { ShowError("Oturma boyu 20–140 cm aralığında olmalı."); return; }

        if (string.IsNullOrWhiteSpace(hasta.TcKimlikNo) ||
            !System.Text.RegularExpressions.Regex.IsMatch(hasta.TcKimlikNo, "^[1-9][0-9]{10}$"))
        { ShowError("TCKN zorunlu; 11 hane ve 0 ile başlamamalı."); return; }

        if (string.IsNullOrWhiteSpace(hasta.Cinsiyet) || (hasta.Cinsiyet != "E" && hasta.Cinsiyet != "K"))
        { ShowError("Cinsiyet zorunlu; 'E' veya 'K' seçin."); return; }

        if (!hasta.BirthDate.HasValue || hasta.BirthDate.Value.Date > DateTime.Today)
        { ShowError("Doğum tarihi zorunlu ve gelecekte olamaz."); return; }

        if (string.IsNullOrWhiteSpace(hasta.Ad) || string.IsNullOrWhiteSpace(hasta.Soyad))
        { ShowError("Ad ve Soyad zorunludur."); return; }

        if (boy.HasValue && (boy < 30 || boy > 220)) { ShowError("Boy 30–220."); return; }
        if (kilo.HasValue && (kilo < 1 || kilo > 200)) { ShowError("Kilo 1–200."); return; }
        if (basCevresi.HasValue && (basCevresi < 25 || basCevresi > 65)) { ShowError("Baş çev. 25–65."); return; }

        if (!string.IsNullOrWhiteSpace(ozet.BoyaUyanTarti) && ozet.BoyaUyanTarti!.Length > 50)
        { ShowError("Boya Uyan Tartı en fazla 50 karakter olabilir."); return; }

        try
        {
            busy = true;

            
            try
            {
                var existing = await Api.GetPatientByTcAsync(hasta.TcKimlikNo!);
                if (existing is not null)
                { ShowError($"Bu TCKN ile kayıt zaten var (Id: {existing.Id})."); return; }
            }
            catch (HttpRequestException httpEx) when (httpEx.StatusCode == HttpStatusCode.NotFound)
            {  }

            if (aileUyeleri.Count == 0 &&
                !string.IsNullOrWhiteSpace(aileForm.Iliski) &&
                !string.IsNullOrWhiteSpace(aileForm.Ad))
                aileUyeleri.Add(aileForm);

            if (diyetler.Count == 0 && diyetForm.Tarih != default)
                diyetler.Add(diyetForm);

            var req = new RegisterRequestDto
            {
                Hasta = hasta,
                AileUyeleri = aileUyeleri.Count > 0 ? aileUyeleri : null,
                Oykuler = Any(oyku) ? oyku : null,
                Diyetler = diyetler.Count > 0 ? diyetler : null,

                Ziyaret = LoginState.IsDoctor
                    ? new ZiyaretCreateDto
                    {
                        Tarih = ilkZiyaretTarihi,
                        Notlar = string.IsNullOrWhiteSpace(ilkZiyaretNotu) ? null : ilkZiyaretNotu
                    }
                    : null,

                Antropometri = (boy.HasValue || kilo.HasValue || basCevresi.HasValue || oturmaBoyuCm.HasValue)
                  ? new AntropometriCreateDto
                  {
                      BoyCm = boy,
                      KiloKg = kilo,
                      BasCevresiCm = basCevresi,
                      OturmaBoyuCm = oturmaBoyuCm
                  } : null,

                PuberteFizik = Any(pf) ? pf : null,
                YorumPlan = Any(yp) ? yp : null,

                OzetHesap = Any(ozet) ? new OzetHesapCreateDto
                {
                    KulacCm = ozet.KulacCm,
                    HedefBoyCm = ozet.HedefBoyCm,
                    BoyaUyanTarti = string.IsNullOrWhiteSpace(ozet.BoyaUyanTarti) ? null : ozet.BoyaUyanTarti.Trim()
                } : null
            };

            var resp = await Api.RegisterAsync(req);

            success = $"Kayıt tamamlandı. HastaID: {resp.HastaId}"
                   + (resp.ZiyaretId is not null ? $", ZiyaretID: {resp.ZiyaretId}" : "")
                   + (resp.AntropometriId is not null ? $", AntropometriID: {resp.AntropometriId}" : "")
                   + (resp.OzetId is not null ? $", OzetID: {resp.OzetId}" : "");

            showSuccess = true;
        }
        catch (Exception ex)
        {
            ShowError(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    static bool Any(OykulerCreateDto o) =>
    !string.IsNullOrWhiteSpace(o.Yakinmalar) ||
    !string.IsNullOrWhiteSpace(o.Oykusu) ||
    !string.IsNullOrWhiteSpace(o.GebelikOykusu) ||
    !string.IsNullOrWhiteSpace(o.DogumSekli) ||
    !string.IsNullOrWhiteSpace(o.DogumAgirlik) ||
    !string.IsNullOrWhiteSpace(o.DogumBoyu) ||
    !string.IsNullOrWhiteSpace(o.NeonatalDonem) ||
    !string.IsNullOrWhiteSpace(o.NorGelisim) ||
    !string.IsNullOrWhiteSpace(o.SutcocukBeslenme) ||
    !string.IsNullOrWhiteSpace(o.GecirilenHast) ||
    !string.IsNullOrWhiteSpace(o.OperasyonKaza) ||
    !string.IsNullOrWhiteSpace(o.KanAkrabaligi) ||
    !string.IsNullOrWhiteSpace(o.KardesSagligi) ||
    !string.IsNullOrWhiteSpace(o.AileHastaliklar) ||
    o.OlusturmaTarihi != default;

    static bool Any(PuberteFizikCreateDto p) =>
        !string.IsNullOrWhiteSpace(p.PuberteNotu) || !string.IsNullOrWhiteSpace(p.PatolojikFizik);

    static bool Any(YorumPlanCreateDto y) =>
        !string.IsNullOrWhiteSpace(y.TedaviBeslenmeSpor) || !string.IsNullOrWhiteSpace(y.YorumNotlar) || y.OlusturmaTarihi != default;

    static bool Any(OzetHesapCreateDto o) =>
        o is not null && (o.KulacCm.HasValue || o.HedefBoyCm.HasValue || !string.IsNullOrWhiteSpace(o.BoyaUyanTarti));
}

