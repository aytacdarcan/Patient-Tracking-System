@page "/"
@inject NavigationManager Nav

@code {
    bool _navigated;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_navigated)
        {
            _navigated = true;
            return InvokeAsync(() => Nav.NavigateTo("/login"));
        }
        return Task.CompletedTask;
    }
}