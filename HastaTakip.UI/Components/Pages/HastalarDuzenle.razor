@page "/hastalar/duzenle/{id:int}"
@inject HastaTakip.UI.Services.LoginStateService LoginState
@using HastaTakip.UI.Dtos
@using MudBlazor
@inject HastaTakip.UI.Services.HastaApi Api
@inject NavigationManager Nav
@rendermode InteractiveServer

<h3>Hasta Düzenle</h3>

@if (loading)
{
    <p>Yükleniyor…</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <p style="color:#b00020">@error</p>
}
else
{
    <MudPaper Class="pa-4"
              Elevation="0"
              Outlined="true"
              Style="width:100%; max-width:none;">

        <MudGrid Spacing="3">

            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="model.Ad"
                              Label="Ad"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="model.Soyad"
                              Label="Soyad"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker Label="Doğum Tarihi"
                               Date="@model.BirthDate"
                               DateChanged="@(d => model.BirthDate = d)"
                               DateFormat="dd.MM.yyyy"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudSelect T="string"
                           @bind-Value="model.Cinsiyet"
                           Label="Cinsiyet"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Clearable="true"
                           FullWidth="true">
                    <MudSelectItem Value="@("E")">Erkek</MudSelectItem>
                    <MudSelectItem Value="@("K")">Kadın</MudSelectItem>
                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="model.TcKimlikNo"
                              Label="TCKN"
                              MaxLength="11"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="model.Telefon"
                              Label="Telefon"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="model.Email"
                              Label="E-posta"
                              InputType="InputType.Email"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              FullWidth="true" />
            </MudItem>

            <MudItem xs="12">
                <MudTextField @bind-Value="model.Adres"
                              Label="Adres"
                              Lines="2"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              FullWidth="true" />
            </MudItem>

        </MudGrid>

    </MudPaper>

    <MudStack Row="true"
              AlignItems="AlignItems.Center"
              Spacing="2"
              Class="mt-4">

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Save">
            Kaydet
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="Cancel">
            Vazgeç
        </MudButton>

        @if (!string.IsNullOrWhiteSpace(saveError))
        {
            <MudText Color="Color.Error">
                @saveError
            </MudText>
        }

    </MudStack>
}

@code {
    [Parameter] public int id { get; set; }

    bool loading = true;
    string? error;
    string? saveError;

    
    PatientUpdateDto model = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!LoginState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        loading = true;
        error = null;
        saveError = null;

        try
        {
            var d = await Api.GetPatientAsync(id);
            if (d is null) { error = "Hasta bulunamadı."; return; }

            model = new PatientUpdateDto
            {
                Ad = d.Ad,
                Soyad = d.Soyad,
                BirthDate = d.BirthDate,
                Cinsiyet = d.Cinsiyet,
                TcKimlikNo = d.TcKimlikNo,
                Telefon = d.Telefon,
                Email = d.Email,
                Adres = d.Adres
            };
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loading = false; }
    }

    async Task Save()
    {
        saveError = null;
        try
        {
            await Api.UpdatePatientAsync(id, model);
           
            Nav.NavigateTo($"/hastalar/{id}");
        }
        catch (Exception ex) { saveError = ex.Message; }
    }

    void Cancel() => Nav.NavigateTo($"/hastalar/{id}");
}
