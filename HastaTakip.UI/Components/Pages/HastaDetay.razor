@page "/hastalar/{id:int}"
@inject HastaTakip.UI.Services.LoginStateService LoginState
@using HastaTakip.UI.Dtos
@using MudBlazor
@inject HastaTakip.UI.Services.HastaApi Api
@inject NavigationManager Nav
@inject HttpClient Http
@rendermode InteractiveServer



<h3>Hasta Detay</h3>

@if (loading)
{
    <p>Yükleniyor...</p>
}
else if (!string.IsNullOrWhiteSpace(error))
{
    <p style="color:red">@error</p>
}
else if (bundle is null)
{
    <p>Kayıt bulunamadı.</p>
}
else
{
    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
        <div style="flex:1;">

            <MudPaper Class="pa-6 mb-4" Elevation="1">

                <MudStack Row="true"
                    AlignItems="AlignItems.Center"
                    Justify="Justify.SpaceBetween"
                    Class="mb-4">
                    <div class="patient-identity">

                        <div class="patient-avatar">
                            @bundle.Hasta.Ad?.Substring(0, 1)
                        </div>

                        <div>
                            <div class="patient-title">
                                @bundle.Hasta.Ad @bundle.Hasta.Soyad
                            </div>

                            <div class="patient-subtitle">
                                Hasta Profili
                            </div>
                        </div>

                    </div>

                    
                        <MudStack Row="true" Spacing="2">

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="Back">
                                Geri
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="Edit">
                                Düzenle
                            </MudButton>

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Error"
                                       OnClick="DeleteAll">
                                Hasta Sil
                            </MudButton>

                        </MudStack>
                    
                </MudStack>

                <MudGrid Spacing="2">

                    <MudItem xs="12" sm="6">
                        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">TCKN</MudText>
                            <MudText Typo="Typo.body1"><b>@bundle.Hasta.TcKimlikNo</b></MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Doğum Tarihi</MudText>
                            <MudText Typo="Typo.body1"><b>@bundle.Hasta.BirthDate?.ToString("dd.MM.yyyy")</b></MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cinsiyet</MudText>
                            <MudText Typo="Typo.body1">
                                <b>@(bundle.Hasta.Cinsiyet == "E" ? "Erkek" : bundle.Hasta.Cinsiyet == "K" ? "Kadın" : "-")</b>
                            </MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Telefon</MudText>
                            <MudText Typo="Typo.body1"><b>@bundle.Hasta.Telefon</b></MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">E-posta</MudText>
                            <MudText Typo="Typo.body1"><b>@bundle.Hasta.Email</b></MudText>
                        </MudPaper>
                    </MudItem>

                    <MudItem xs="12">
                        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Adres</MudText>
                            <MudText Typo="Typo.body1"><b>@bundle.Hasta.Adres</b></MudText>
                        </MudPaper>
                    </MudItem>

                </MudGrid>

            </MudPaper>
            @if (ceddResults.Count > 0)
            {
                <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">

                    <MudText Typo="Typo.h6" Class="mb-3">
                        ÇEDD Büyüme Değerlendirmesi
                    </MudText>

                    <MudGrid>
                        @foreach (var result in ceddResults.Where(x =>
                                        x.Label == "Height" ||
                                        x.Label == "Weight" ||
                                        x.Label == "BMI"))
                        {
                            <MudItem xs="12" sm="4">
                                <MudPaper Class="pa-3" Elevation="0" Outlined="true">

                                    <MudText Typo="Typo.subtitle1">
                                        <b>@result.Label</b>
                                    </MudText>

                                    <MudText>
                                        @result.Value @result.Unit
                                    </MudText>

                                    <MudText Typo="Typo.body2">
                                        SDS: @(result.Sds?.ToString("0.00") ?? "-")
                                    </MudText>

                                    <MudText Typo="Typo.body2">
                                        Persentil: @(result.Percentile?.ToString("0.00") ?? "-")
                                    </MudText>

                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>

                </MudPaper>
            }

            <section class="dashboard-card">
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Class="mb-4">

                    <MudText Typo="Typo.h6">
                        Aile Üyeleri
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="ToggleAddAile">
                        @((addingAile) ? "Vazgeç" : "Yeni Aile Üyesi")
                    </MudButton>

                </MudStack>
            @if (addingAile)
                {
                    <div class="form-grid mt-2">
                        <MudTextField @bind-Value="aileAdd.Iliski"
                                      Label="İlişki"
                                      Placeholder="Anne/Baba/Kardeş..."
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />

                        <MudTextField @bind-Value="aileAdd.Ad"
                                      Label="Ad"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                        <MudItem xs="12" sm="6" md="4">

                            <MudDatePicker @bind-Date="aileAdd.DogumTarihi"
                                           Label="Doğum"
                                           Variant="Variant.Outlined"
                                           Margin="Margin.Dense"
                                           DateFormat="dd.MM.yyyy" />

                        </MudItem>
                        <MudNumericField T="decimal?"
                                         @bind-Value="aileAdd.BoyCm"
                                         Label="Boy (cm)"
                                         Step="0.1M"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense" />
                        <MudNumericField T="decimal?"
                                         @bind-Value="aileAdd.AgirlikKg"
                                         Label="Kilo (kg)"
                                         Step="0.1M"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense" />
                        <MudNumericField T="double?"
                                         @bind-Value="aileAdd.PuberteYasiYil"
                                         Label="Puberte Yaşı (yıl)"
                                         Step="1"
                                         Min="0d"
                                         Max="25d"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense" />
                        <MudTextField @bind-Value="aileAdd.SaglikDurumu"
                                      Label="Sağlık Durumu"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="col-span-3" />

                        <MudTextField @bind-Value="aileAdd.Meslek"
                                      Label="Meslek"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="col-span-3" />
                    </div>
                    <MudStack Row="true" Spacing="2" Class="mt-3">

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@string.IsNullOrWhiteSpace(aileAdd.Iliski)"
                                   OnClick="SaveAddAile">
                            Ekle
                        </MudButton>

                        @if (!string.IsNullOrWhiteSpace(aileError))
                        {
                            <MudText Color="Color.Error">
                                @aileError
                            </MudText>
                        }

                    </MudStack>
                }


                @if (bundle.AileUyeleri.Count == 0)
                {
                    <MudText Color="Color.Secondary" Class="mt-2">
                        Kayıt bulunamadı.
                    </MudText>
                }
                
                else
                {
                    @foreach (var a in bundle.AileUyeleri)
                    {
                        var isEdit = aileEdits.ContainsKey(a.AileUyesiID);

                        
                            @if (!isEdit
                            )
                            {
                                <MudPaper Class="pa-4 mb-2" Elevation="0" Outlined="true">

                                    <div style="display:flex;justify-content:space-between;gap:.75rem;align-items:center;">
                                        <div>
                                            <b>@a.Iliski?.ToUpper()</b> — @Dash(a.Ad)
                                            (@(a.DogumTarihi.HasValue? a.DogumTarihi.Value.ToString("dd.MM.yyyy") : "-"))
                                        </div>

                                        <MudStack Row="true" Spacing="1">

                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Primary"
                                                       Size="Size.Small"
                                                       OnClick="@(() => StartEditAile(a))">
                                                Düzenle
                                            </MudButton>

                                            <MudButton Variant="Variant.Filled"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => DeleteAile(a.AileUyesiID))">
                                                Sil
                                            </MudButton>

                                        </MudStack>
                                    </div>

                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-3">

                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                                            Boy: @(a.BoyCm?.ToString("0.#") ?? "-") cm
                                        </MudChip>

                                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined">
                                            Kilo: @(a.AgirlikKg?.ToString("0.#") ?? "-") kg
                                        </MudChip>

                                        <MudChip T="string" Color="Color.Secondary" Variant="Variant.Outlined">
                                            Sağlık: @Dash(a.SaglikDurumu)
                                        </MudChip>

                                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">
                                            Meslek: @Dash(a.Meslek)
                                        </MudChip>

                                    </MudStack>

                                </MudPaper>
                            }

                    else
                    {
                        <div class="form-grid mt-2">

                            <MudTextField @bind-Value="aileEdits[a.AileUyesiID].Iliski"
                                          Label="İlişki"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="aileEdits[a.AileUyesiID].Ad"
                                          Label="Ad"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <label>
                                Doğum
                                <input class="input-text"
                                       type="date"
                                       @bind="aileEdits[a.AileUyesiID].DogumTarihi" />
                            </label>

                            <MudNumericField T="decimal?"
                                             @bind-Value="aileEdits[a.AileUyesiID].BoyCm"
                                             Label="Boy (cm)"
                                             Step="0.1M"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />

                            <MudNumericField T="decimal?"
                                             @bind-Value="aileEdits[a.AileUyesiID].AgirlikKg"
                                             Label="Kilo (kg)"
                                             Step="0.1M"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />

                            <MudNumericField T="int?"
                                             @bind-Value="aileEdits[a.AileUyesiID].PuberteYasiYil"
                                             Label="Puberte Yaşı"
                                             Step="1"
                                             Min="0"
                                             Max="25"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />

                            <MudTextField @bind-Value="aileEdits[a.AileUyesiID].SaglikDurumu"
                                          Label="Sağlık Durumu"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="col-span-3" />

                            <MudTextField @bind-Value="aileEdits[a.AileUyesiID].Meslek"
                                          Label="Meslek"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="col-span-3" />

                        </div>

                        <MudStack Row="true" Spacing="2" Class="mt-3">

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="@(() => SaveEditAile(a.AileUyesiID))">
                                Kaydet
                            </MudButton>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       OnClick="@(() => CancelEditAile(a.AileUyesiID))">
                                İptal
                            </MudButton>

                            @if (!string.IsNullOrWhiteSpace(aileError))
                            {
                                <MudText Color="Color.Error">
                                    @aileError
                                </MudText>
                            }

                        </MudStack>
                    }
                       
                    }
                }
            </section>

            <section class="dashboard-card">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Class="mb-4">

                    <MudText Typo="Typo.h6">
                        Öykü
                    </MudText>

                    @if (bundle.Oykuler is null)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="StartAddOyku">
                            Öykü Ekle
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   OnClick="ToggleEditOyku">
                            @(editOyku ? "İptal" : "Düzenle")
                        </MudButton>
                    }

                </MudStack>

                @if (bundle.Oykuler is null)
                {
                    @if (addOyku)
                    {
                        <div class="form-grid mt-2">
                            <MudTextField @bind-Value="oykuCreate.Yakinmalar"
                                          Label="Yakınmalar"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="3" />

                            <MudTextField @bind-Value="oykuCreate.Oykusu"
                                          Label="Öyküsü"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="3" />
                            <MudTextField @bind-Value="oykuEdit.GebelikOykusu"
                                          Label="Gebelik Öyküsü"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                            <MudTextField @bind-Value="oykuCreate.DogumSekli"
                                          Label="Doğum Şekli"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuCreate.DogumAgirlik"
                                          Label="Doğum Ağırlığı"
                                          Placeholder="örn: 3200 gr"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuCreate.DogumBoyu"
                                          Label="Doğum Boyu"
                                          Placeholder="örn: 50 cm"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuCreate.NeonatalDonem"
                                          Label="Neonatal Dönem"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuCreate.NorGelisim"
                                          Label="Nör. Gelişim"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuCreate.SutcocukBeslenme"
                                          Label="Süt/Çocuk Beslenme"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuCreate.GecirilenHast"
                                          Label="Geçirilen Hastalıklar"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuCreate.OperasyonKaza"
                                          Label="Operasyon/Kaza"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuCreate.KardesSagligi"
                                          Label="Kardeş Sağlığı"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuCreate.AileHastaliklar"
                                          Label="Aile Hastalıkları"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                            <MudTextField @bind-Value="oykuCreate.KanAkrabaligi"
                                          Label="Kan Akrabalığı"
                                          Placeholder="örn: Yok / 1. derece kuzen evliliği"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="col-span-2" />
                            <label class="col-span-2">
                                Oluşturma Tarihi
                                <input class="input-text" type="datetime-local" @bind="oykuCreate.OlusturmaTarihi" />
                            </label>
                        </div>
                        <MudStack Row="true" Spacing="2" Class="mt-3">

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="SaveAddOyku">
                                Kaydet
                            </MudButton>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       OnClick="@(() => addOyku = false)">
                                Vazgeç
                            </MudButton>

                        </MudStack>
                    }
                    else
                    {
                        <MudText Color="Color.Secondary">
                            Kayıt bulunamadı.
                        </MudText>
                    }
                }
                else
                {
                    @if (!editOyku)
                    {
                        <MudPaper Class="pa-4 mt-2" Elevation="0" Outlined="true">

                            <MudStack Spacing="1">

                                <MudText><b>Yakınmalar:</b> @Dash(bundle.Oykuler.Yakinmalar)</MudText>

                                <MudText><b>Öyküsü:</b> @Dash(bundle.Oykuler.Oykusu)</MudText>

                                <MudText><b>Gebelik Öyküsü:</b> @Dash(bundle.Oykuler.GebelikOykusu)</MudText>

                                <MudText><b>Doğum Şekli:</b> @Dash(bundle.Oykuler.DogumSekli)</MudText>

                                <MudText><b>Doğum Ağırlığı:</b> @Dash(bundle.Oykuler.DogumAgirlik)</MudText>

                                <MudText><b>Doğum Boyu:</b> @Dash(bundle.Oykuler.DogumBoyu)</MudText>

                                <MudText><b>Neonatal Dönem:</b> @Dash(bundle.Oykuler.NeonatalDonem)</MudText>

                                <MudText><b>Nör. Gelişim:</b> @Dash(bundle.Oykuler.NorGelisim)</MudText>

                                <MudText><b>Süt/Çocuk Beslenme:</b> @Dash(bundle.Oykuler.SutcocukBeslenme)</MudText>

                                <MudText><b>Geçirilen Hastalıklar:</b> @Dash(bundle.Oykuler.GecirilenHast)</MudText>

                                <MudText><b>Operasyon/Kaza:</b> @Dash(bundle.Oykuler.OperasyonKaza)</MudText>

                                <MudText><b>Kan Akrabalığı:</b> @Dash(bundle.Oykuler.KanAkrabaligi)</MudText>

                                <MudText><b>Kardeş Sağlığı:</b> @Dash(bundle.Oykuler.KardesSagligi)</MudText>

                                <MudText><b>Aile Hastalıkları:</b> @Dash(bundle.Oykuler.AileHastaliklar)</MudText>

                                <MudText>
                                    <b>Oluşturma:</b>
                                    @($"{bundle.Oykuler.OlusturmaTarihi:dd.MM.yyyy HH:mm}")
                                </MudText>

                            </MudStack>

                        </MudPaper>
                    }
                    else
                    {
                        <div class="form-grid mt-2">
                            <MudTextField @bind-Value="oykuEdit.Yakinmalar"
                                          Label="Yakınmalar"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="3"
                                          Class="col-span-2" />

                            <MudTextField @bind-Value="oykuEdit.Oykusu"
                                          Label="Öyküsü"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Lines="3"
                                          Class="col-span-2" />

                            <MudTextField @bind-Value="oykuEdit.GebelikOykusu"
                                          Label="Gebelik Öyküsü"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.DogumSekli"
                                          Label="Doğum Şekli"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.DogumAgirlik"
                                          Label="Doğum Ağırlığı"
                                          Placeholder="örn: 3200 gr"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.DogumBoyu"
                                          Label="Doğum Boyu"
                                          Placeholder="örn: 50 cm"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.NeonatalDonem"
                                          Label="Neonatal Dönem"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.NorGelisim"
                                          Label="Nör. Gelişim"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.SutcocukBeslenme"
                                          Label="Süt/Çocuk Beslenme"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.GecirilenHast"
                                          Label="Geçirilen Hastalıklar"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.OperasyonKaza"
                                          Label="Operasyon/Kaza"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.KanAkrabaligi"
                                          Label="Kan Akrabalığı"
                                          Placeholder="örn: Yok / 1. derece kuzen evliliği"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Class="col-span-2" />

                            <MudTextField @bind-Value="oykuEdit.KardesSagligi"
                                          Label="Kardeş Sağlığı"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <MudTextField @bind-Value="oykuEdit.AileHastaliklar"
                                          Label="Aile Hastalıkları"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />

                            <label class="col-span-2">
                                Oluşturma Tarihi
                                <input class="input-text" type="datetime-local" @bind="oykuEdit.OlusturmaTarihi" />
                            </label>
                        </div>

                        <MudStack Row="true" Spacing="2" Class="mt-3">

                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="SaveEditOyku">
                                Kaydet
                            </MudButton>

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       OnClick="ToggleEditOyku">
                                İptal
                            </MudButton>

                            @if (!string.IsNullOrWhiteSpace(localError))
                            {
                                <MudText Color="Color.Error">
                                    @localError
                                </MudText>
                            }

                        </MudStack>
                    }
                }
            </section>

            <section class="dashboard-card">

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Class="mb-4">

                    <MudText Typo="Typo.h6">
                        Beslenme / Alışkanlıklar (Son 10)
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="ToggleAddDiyet">
                        @((addingDiyet) ? "Vazgeç" : "Yeni Kayıt Ekle")
                    </MudButton>

                </MudStack>

                @if (addingDiyet)
                {
                    <div class="form-grid mt-2">

                        <label>
                            Tarih
                            <input class="input-text" type="date" @bind="diyetAdd.Tarih" />
                        </label>

                        <MudTextField @bind-Value="diyetAdd.Ekmek" Label="Ekmek" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.Tahil" Label="Tahıl" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.Et" Label="Et" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.Peynir" Label="Peynir" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.Sut" Label="Süt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.Yogurt" Label="Yoğurt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.Meyve" Label="Meyve" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.Sebze" Label="Sebze" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.SiviGida" Label="Şekerli İçecek" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.AburCubur" Label="Abur Cubur" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudTextField @bind-Value="diyetAdd.EkranSuresi" Label="Ekran Süresi" Variant="Variant.Outlined" Margin="Margin.Dense" />

                    </div>

                    <MudStack Row="true" Spacing="2" Class="mt-3">

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Disabled="@(diyetAdd.Tarih == default)"
                                   OnClick="SaveAddDiyet">
                            Kaydet
                        </MudButton>

                        @if (!string.IsNullOrWhiteSpace(localError))
                        {
                            <MudText Color="Color.Error">
                                @localError
                            </MudText>
                        }

                    </MudStack>
                }

                @if (bundle.Diyetler.Count == 0)
                {
                    <MudText Color="Color.Secondary">
                        Kayıt bulunamadı.
                    </MudText>
                }
                else
                {
                    @foreach (var d in bundle.Diyetler)
                    {
                        var edit = diyetEdits.ContainsKey(d.DiyetID);

                        <MudPaper Class="pa-4 mb-2" Elevation="0" Outlined="true">

                            @if (!edit)
                            {
                                <MudStack Row="true"
                                          AlignItems="AlignItems.Center"
                                          Justify="Justify.SpaceBetween"
                                          Class="mb-3">

                                    <MudText Typo="Typo.subtitle1">
                                        <b>@d.Tarih.ToString("dd.MM.yyyy")</b>
                                    </MudText>

                                    <MudStack Row="true" Spacing="1">
                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   OnClick="@(() => StartEditDiyet(d))">
                                            Düzenle
                                        </MudButton>

                                        <MudButton Variant="Variant.Filled"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => DeleteDiyet(d.DiyetID))">
                                            Sil
                                        </MudButton>
                                    </MudStack>

                                </MudStack>

                                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-3">

                                    <MudChip T="string" Variant="Variant.Outlined">Ekmek: @Dash(d.Ekmek)</MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">Tahıl: @Dash(d.Tahil)</MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">Et: @Dash(d.Et)</MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">Peynir: @Dash(d.Peynir)</MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">Süt: @Dash(d.Sut)</MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">Yoğurt: @Dash(d.Yogurt)</MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">Meyve: @Dash(d.Meyve)</MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">Sebze: @Dash(d.Sebze)</MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">
                                        Şekerli İçecek: @Dash(d.SiviGida)
                                    </MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">
                                        Abur Cubur: @Dash(d.AburCubur)
                                    </MudChip>

                                    <MudChip T="string" Variant="Variant.Outlined">
                                        Ekran Süresi: @Dash(d.EkranSuresi)
                                    </MudChip>

                                </MudStack>
                            }
                            else
                            {
                                <div class="form-grid mt-2">

                                    <label>
                                        Tarih
                                        <input class="input-text" type="date" @bind="diyetEdits[d.DiyetID].Tarih" />
                                    </label>

                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].Ekmek" Label="Ekmek" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].Tahil" Label="Tahıl" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].Et" Label="Et" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].Peynir" Label="Peynir" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].Sut" Label="Süt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].Yogurt" Label="Yoğurt" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].Meyve" Label="Meyve" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].Sebze" Label="Sebze" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].SiviGida" Label="Şekerli İçecek" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].AburCubur" Label="Abur Cubur" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField @bind-Value="diyetEdits[d.DiyetID].EkranSuresi" Label="Ekran Süresi" Variant="Variant.Outlined" Margin="Margin.Dense" />

                                </div>

                                <MudStack Row="true" Spacing="2" Class="mt-3">

                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               OnClick="@(() => SaveEditDiyet(d.DiyetID))">
                                        Kaydet
                                    </MudButton>

                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Default"
                                               OnClick="@(() => CancelEditDiyet(d.DiyetID))">
                                        İptal
                                    </MudButton>

                                    @if (!string.IsNullOrWhiteSpace(localError))
                                    {
                                        <MudText Color="Color.Error">
                                            @localError
                                        </MudText>
                                    }

                                </MudStack>
                            }

                        </MudPaper>
                    }
                }
            </section>

            <section class="dashboard-card">
                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween"
                          Class="mb-4">

                    <MudText Typo="Typo.h6">
                        Ziyaretler
                    </MudText>

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="YeniZiyaret">
                        Yeni Ziyaret
                    </MudButton>

                </MudStack>

                @if (visits is null)
                {
                    <MudProgressCircular Color="Color.Primary"
                                         Indeterminate="true" />
                }
                else if (visits.Items.Count == 0)
                {
                    <MudText Color="Color.Secondary">
                        Kayıt yok.
                    </MudText>
                }
                else
                {
                    <MudTable Items="@visits.Items"
                              Hover="true"
                              Elevation="0">

                        <HeaderContent>
                            <MudTh>Tarih</MudTh>
                            <MudTh>Notlar</MudTh>
                            <MudTh>İşlem</MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd DataLabel="Tarih">
                                <b>@(context.Tarih is { } vt ? $"{vt:dd.MM.yyyy}" : "-")</b>
                            </MudTd>

                            <MudTd DataLabel="Notlar">
                                @context.Notlar
                            </MudTd>

                            <MudTd>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenVisit(context))">
                                    Detay
                                </MudButton>
                            </MudTd>
                        </RowTemplate>

                    </MudTable>

                    <MudStack Row="true"
                              AlignItems="AlignItems.Center"
                              Spacing="2"
                              Class="mt-3">

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(currentPage <= 1)"
                                   OnClick="PrevPage">
                            Önceki
                        </MudButton>

                        <MudText>
                            Sayfa @currentPage
                        </MudText>

                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Disabled="@(visits.Items.Count < pageSize)"
                                   OnClick="NextPage">
                            Sonraki
                        </MudButton>

                    </MudStack>
                }
            </section>


            <!-- Removed growth chart section -->

        </div>
    </div>
}
@code {
    [Parameter] public int id { get; set; }

    bool loading;
    string? error;
    PatientBundleDto? bundle;
    List<CeddResultDto> ceddResults = new();

    bool addingAile = false;
    AileUyesiCreateDto aileAdd = new();               
    Dictionary<int, AileUyesiUpdateDto> aileEdits = new(); 
    string? aileError;

    bool editOyku = false;
    bool addOyku = false;
    OykulerUpdateDto oykuEdit = new();
    OykulerCreateDto oykuCreate = new() { HastaID = 0 }; 

   
    Dictionary<int, DiyetUpdateDto> diyetEdits = new();
    string? localError;
    PagedResult<ZiyaretDetayDto>? visits;
    int currentPage = 1, pageSize = 10;
    

    async Task LoadVisits() =>
    visits = await Api.GetPatientVisitsDetailAsync(id, currentPage, pageSize);
    
    async Task LoadCedd()
    {
        if (bundle is null)
            return;

        var measurements = await Api.GetAnthroByHastaAsync(id);

        var latest = measurements
            .Where(x =>
                x.YasAy.HasValue &&
                x.BoyCm.HasValue &&
                x.KiloKg.HasValue)
            .OrderByDescending(x => x.YasAy)
            .FirstOrDefault();

        if (latest is null)
            return;

        var sex = bundle.Hasta.Cinsiyet == "E"
            ? "male"
            : "female";

        var ageYears = latest.YasAy!.Value / 12.0;

        ceddResults = await Api.GetCeddCalculationAsync(
            sex,
            ageYears,
            Convert.ToDouble(latest.BoyCm!.Value),
            Convert.ToDouble(latest.KiloKg!.Value));
    }

    void PrevPage() { if (currentPage > 1) { currentPage--; _ = LoadVisits(); } }
    void NextPage() { if (visits?.Items?.Count == pageSize) { currentPage++; _ = LoadVisits(); } }

    void YeniZiyaret() => Nav.NavigateTo($"/ziyaretler/yeni/{id}");


    void OpenVisit(ZiyaretDetayDto v)
    {
        var t = v.Tarih is { } vt ? Uri.EscapeDataString($"{vt:yyyy-MM-dd}") : "";
        var n = Uri.EscapeDataString(v.Notlar ?? "");
        Nav.NavigateTo($"/ziyaretler/{v.ZiyaretID}?t={t}&n={n}");
    }

    void ToggleEditOyku()
    {
        localError = null;
        if (bundle?.Oykuler is null) return;

        editOyku = !editOyku;

        if (editOyku)
        {
            var o = bundle.Oykuler;

            oykuEdit = new OykulerUpdateDto
            {
                Yakinmalar = o.Yakinmalar,
                Oykusu = o.Oykusu,
                GebelikOykusu = o.GebelikOykusu,
                DogumSekli = o.DogumSekli,

                DogumAgirlik = o.DogumAgirlik,
                DogumBoyu = o.DogumBoyu,

                NeonatalDonem = o.NeonatalDonem,
                NorGelisim = o.NorGelisim,
                SutcocukBeslenme = o.SutcocukBeslenme,
                GecirilenHast = o.GecirilenHast,
                OperasyonKaza = o.OperasyonKaza,

                KanAkrabaligi = o.KanAkrabaligi,
                KardesSagligi = o.KardesSagligi,
                AileHastaliklar = o.AileHastaliklar,

                OlusturmaTarihi = o.OlusturmaTarihi
            };
        }
    }

    void StartAddOyku()
    {
        addOyku = true;
        localError = null;
        oykuCreate = new OykulerCreateDto
        {
            HastaID = bundle?.Hasta.Id ?? id,
            OlusturmaTarihi = DateTime.Now
        };
    }

    async Task SaveEditOyku()
    {
        if (bundle?.Oykuler is null) return;
        try
        {
            await Api.UpdateOykuAsync(bundle.Oykuler.OykulerID, oykuEdit);
            bundle = await Api.GetPatientBundleAsync(id);
            editOyku = false;
            localError = null;
            StateHasChanged();
        }
        catch (Exception ex) { localError = ex.Message; }
    }

    async Task SaveAddOyku()
    {
        try
        {
            oykuCreate.HastaID = bundle?.Hasta.Id ?? id;
            var newId = await Api.CreateOykuAsync(oykuCreate);
            bundle = await Api.GetPatientBundleAsync(id);
            addOyku = false;
            localError = null;
        }
        catch (Exception ex) { localError = ex.Message; }
    }

    bool addingDiyet = false;
    DiyetCreateDto diyetAdd = new() { Tarih = DateTime.Today };

    void ToggleAddDiyet()
    {
        addingDiyet = !addingDiyet;
        localError = null;
        if (addingDiyet)
            diyetAdd = new DiyetCreateDto { Tarih = DateTime.Today };
    }

    async Task SaveAddDiyet()
    {
        try
        {
            if (diyetAdd.Tarih == default)
            {
                localError = "Tarih zorunludur.";
                return;
            }

            diyetAdd.HastaID = bundle?.Hasta.Id ?? id;
            await Api.CreateDiyetAsync(diyetAdd);
            bundle = await Api.GetPatientBundleAsync(id);
            addingDiyet = false;
            localError = null;
            StateHasChanged();
        }
        catch (Exception ex) { localError = ex.Message; }
    }

    void StartEditDiyet(DiyetListDto d)
    {
        localError = null;
        if (!diyetEdits.ContainsKey(d.DiyetID))
        {
            diyetEdits[d.DiyetID] = new DiyetUpdateDto
            {
                Tarih = d.Tarih,
                Ekmek = d.Ekmek,
                Tahil = d.Tahil,

                Et = d.Et,
                Peynir = d.Peynir,

                Sut = d.Sut,
                Yogurt = d.Yogurt,

                Meyve = d.Meyve,
                Sebze = d.Sebze,

                SiviGida = d.SiviGida,
                AburCubur = d.AburCubur,
                EkranSuresi = d.EkranSuresi
            };
        }
    }

    void CancelEditDiyet(int diyetId)
    {
        diyetEdits.Remove(diyetId);
        localError = null;
    }

    async Task SaveEditDiyet(int diyetId)
    {
        if (!diyetEdits.TryGetValue(diyetId, out var dto)) return;
        try
        {
            await Api.UpdateDiyetAsync(diyetId, dto);
            diyetEdits.Remove(diyetId);
            bundle = await Api.GetPatientBundleAsync(id);
            localError = null;
            StateHasChanged();
        }
        catch (Exception ex) { localError = ex.Message; }
    }

    async Task DeleteDiyet(int diyetId)
    {
        if (!await ConfirmAsync("Bu diyet kaydını silmek istediğinize emin misiniz?")) return;
        try
        {
            await Api.DeleteDiyetAsync(diyetId);
            bundle = await Api.GetPatientBundleAsync(id);
            StateHasChanged();
        }
        catch (Exception ex) { localError = ex.Message; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!LoginState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        loading = true;
        error = null;

        try
        {
            bundle = await Api.GetPatientBundleAsync(id);
            ceddResults.Clear();

            if (bundle is null)
            {
                error = "Hasta kaydı bulunamadı.";
            }
            else
            {
                await LoadVisits();
                await LoadCedd();
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }

        loading = false;
    }


    void Back() => Nav.NavigateTo("/hastalar");
    void Edit() => Nav.NavigateTo($"/hastalar/duzenle/{id}");

    async Task<bool> ConfirmAsync(string msg)
    {
        return await JS.InvokeAsync<bool>("confirm", msg);
    }

    [Inject] IJSRuntime JS { get; set; } = default!;
    string Dash(string? s) => string.IsNullOrWhiteSpace(s) ? "-" : s;

    void ToggleAddAile()
    {
        addingAile = !addingAile;
        aileError = null;
        if (addingAile)
        {
            aileAdd = new AileUyesiCreateDto
            {
                HastaID = bundle?.Hasta.Id ?? id
            };
        }
    }

    async Task SaveAddAile()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(aileAdd.Iliski))
            {
                aileError = "İlişki zorunludur.";
                return;
            }

            await Api.CreateAileUyesiAsync(aileAdd);
            bundle = await Api.GetPatientBundleAsync(id);
            addingAile = false;
            aileError = null;
            StateHasChanged();
        }
        catch (Exception ex) { aileError = ex.Message; }
    }

    void StartEditAile(AileUyesiListDto a)
    {
        aileError = null;
        if (!aileEdits.ContainsKey(a.AileUyesiID))
        {
            aileEdits[a.AileUyesiID] = new AileUyesiUpdateDto
            {
                Iliski = a.Iliski,
                Ad = a.Ad,
                DogumTarihi = a.DogumTarihi,
                BoyCm = a.BoyCm,
                AgirlikKg = a.AgirlikKg,
                PuberteYasiYil = a.PuberteYasiYil.HasValue ? (int?)Math.Round(a.PuberteYasiYil.Value) : null,
                SaglikDurumu = a.SaglikDurumu,
                Meslek = a.Meslek
            };
        }
    }

    void CancelEditAile(int aileUyesiId)
    {
        aileEdits.Remove(aileUyesiId);
        aileError = null;
    }

    async Task SaveEditAile(int aileUyesiId)
    {
        if (!aileEdits.TryGetValue(aileUyesiId, out var dto)) return;
        try
        {
            await Api.UpdateAileUyesiAsync(aileUyesiId, dto);
            aileEdits.Remove(aileUyesiId);
            bundle = await Api.GetPatientBundleAsync(id);
            aileError = null;
            StateHasChanged();
        }
        catch (Exception ex) { aileError = ex.Message; }
    }

    async Task DeleteAile(int aileUyesiId)
    {
        if (!await ConfirmAsync("Bu aile üyesini silmek istediğinize emin misiniz?")) return;
        try
        {
            await Api.DeleteAileUyesiAsync(aileUyesiId);
            bundle = await Api.GetPatientBundleAsync(id);
            StateHasChanged();
        }
        catch (Exception ex) { aileError = ex.Message; }
    }
    async Task DeleteAll()
    {
        if (!await ConfirmAsync("Bu hastaya ait TÜM veriler (ziyaretler, öykü, diyetler vb.) kalıcı olarak silinecek. Emin misiniz?"))
            return;

        try
        {
            await Api.DeletePatientCascadeAsync(id);
            Nav.NavigateTo("/hastalar");
        }
        catch (Exception ex)
        {
            error = ex.Message;
            StateHasChanged();
        }
    }
    


}


