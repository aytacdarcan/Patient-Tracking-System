@page "/ziyaretler/{ziyaretId:int}/lab"
@inject HastaTakip.UI.Services.LoginStateService LoginState
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject HastaTakip.UI.Services.HastaApi Api
@using HastaTakip.UI.Dtos

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Ziyaret Laboratuvar Sonuçları</h3>
    <button class="btn btn-outline-secondary btn-sm" @onclick="Geri">Geri</button>
</div>

@if (loading)
{
    <p>Yükleniyor…</p>
}
else
{
    <div class="card p-3 mb-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Tarih</label>
                <input class="form-control" type="date" value="@labDate.ToString("yyyy-MM-dd")" @onchange="OnDateChanged" disabled="@(!canEdit)" />
            </div>

            <div class="col-md-9 text-end">
                @if (hasAnyResult)
                {
                    @if (canEdit)
                    {
                        <button class="btn btn-outline-secondary me-2" @onclick="CancelEdit">Vazgeç</button>
                        <button class="btn btn-success" @onclick="SaveAll">Kaydet</button>
                    }
                    else if (isDoctor)
                    {
                        <button class="btn btn-primary" @onclick="EnableEdit">Düzenle</button>
                    }
                }
                else
                {
                    <button class="btn btn-success" @onclick="SaveAll" disabled="@(isDoctor == false)">Kaydet</button>
                }
            </div>
        </div>

        <div class="mt-3">
            <table class="table table-sm table-bordered lab-table">
                <thead>
                    <tr>
                        <th>Parametre</th>
                        <th style="width:40%;">Değer</th>
                        <th style="width:15%;">Alt</th>
                        <th style="width:15%;">Üst</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in parametreler)
                    {
                        var model = edits[p.LabParametreID];
                        <tr>
                            <td>@p.Ad @(string.IsNullOrWhiteSpace(p.Birim) ? "" : $"({p.Birim})")</td>
                            <td>
                                <input class="form-control"
                                       @bind="model.Deger"
                                       disabled="@(!canEdit)" />
                            </td>
                            <td>
                                <input class="form-control"
                                       type="number"
                                       step="0.01"
                                       @bind="model.RefAlt"
                                       disabled="@(!canEdit)" />
                            </td>
                            <td>
                                <input class="form-control"
                                       type="number"
                                       step="0.01"
                                       @bind="model.RefUst"
                                       disabled="@(!canEdit)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (!string.IsNullOrWhiteSpace(error))
        {
            <div class="text-danger mt-2">@error</div>
        }
    </div>
}

@code {
    [Parameter] public int ziyaretId { get; set; }

    bool loading = true;
    string? error;
    List<LabParametreDto> parametreler = new();
    Dictionary<int, LabRowEdit> edits = new();
    DateTime labDate = DateTime.Today;
    bool hasAnyResult = false;
    bool isDoctor => LoginState.IsDoctor;
    bool canEdit = false;

    class LabRowEdit
    {
        public string? Deger { get; set; }
        public decimal? RefAlt { get; set; }
        public decimal? RefUst { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        parametreler = await Api.GetLabParametrelerAsync();
        foreach (var p in parametreler)
            edits[p.LabParametreID] = new LabRowEdit();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!LoginState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        loading = true;
        error = null;

        try
        {
            var existing = await Api.GetLabResultsForVisitAsync(ziyaretId);
            if (existing?.Any() == true)
            {
                var latestDate = existing.Max(x => x.Tarih);
                labDate = latestDate;

                foreach (var e in existing)
                {
                    if (!edits.ContainsKey(e.LabParametreID)) continue;
                    edits[e.LabParametreID].Deger = e.Deger;
                    edits[e.LabParametreID].RefAlt = e.RefAlt;
                    edits[e.LabParametreID].RefUst = e.RefUst;
                }

                hasAnyResult = true;
                canEdit = false;
            }
            else
            {
                hasAnyResult = false;
                canEdit = isDoctor;
            }
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    void OnDateChanged(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e?.Value?.ToString(), out var dt))
            labDate = dt;
    }

    void EnableEdit()
    {
        if (isDoctor) canEdit = true;
    }

    async Task CancelEdit()
    {
 
        await OnParametersSetAsync();
        canEdit = hasAnyResult ? false : isDoctor;
    }

    async Task SaveAll()
    {
        if (!isDoctor)
        {
            error = "Yetkiniz yok.";
            return;
        }

        error = null;
        try
        {
            var items = edits
                .Select(kv => new LabSonucForVisitDto
                {
                    LabParametreID = kv.Key,
                    Deger = string.IsNullOrWhiteSpace(kv.Value.Deger) ? null : kv.Value.Deger,
                    RefAlt = kv.Value.RefAlt,
                    RefUst = kv.Value.RefUst
                })
                .Where(x => x.Deger != null)
                .ToList();

            if (items.Count == 0)
            {
                error = "Kaydetmek için en az bir değer girin.";
                return;
            }

            var bulk = new LabForVisitBulkDto { Tarih = labDate, Items = items };
            await Api.UpsertLabResultsForVisitAsync(ziyaretId, bulk);
            await OnParametersSetAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
    }

    void Geri() => Nav.NavigateTo($"/ziyaretler/{ziyaretId}");
}

<style>
    .lab-table th {
        background: #f5f6fa;
        text-align: center;
        vertical-align: middle;
        white-space: nowrap;
    }

    .lab-table td {
        text-align: center;
        vertical-align: middle;
    }
</style>
