@page "/hastalar"
@inject HastaTakip.UI.Services.LoginStateService LoginState
@rendermode InteractiveServer
@using HastaTakip.UI.Dtos
@using HastaTakip.UI.Services
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@inject HastaApi Api
@inject NavigationManager Nav

<div class="page-card">

    <div class="page-header">
        <div>
            <h3>Hastalar</h3>
        </div>

        @* MudBlazor Bileşenleri ile Güncellenen Toolbar *@
        <div class="toolbar" style="display: flex; align-items: center; gap: .5rem;">
            <MudTextField T="string"
                          Value="@q"
                          ValueChanged="@(async value => await OnSearchChanged(value))"
                          Placeholder="İsim / TCKN..."
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Style="width:260px; margin-top: 0;" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="Search">
                Ara
            </MudButton>

            <MudButton Href="/hastalar/yeni"
                       Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Add">
                Yeni Hasta
            </MudButton>
        </div>
    </div>

    @if (loading)
    {
        <div class="d-flex justify-center my-4">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <MudText Color="Color.Error">Error: @error</MudText>
    }
    else
    {
        <MudTable Items="@data.Items" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0" Class="patients-table">
            <HeaderContent>
                <MudTh Style="font-weight:700; color:#475569;">Ad Soyad</MudTh>
                <MudTh Style="font-weight:700; color:#475569;">Cinsiyet</MudTh>
                <MudTh Style="font-weight:700; color:#475569; cursor:pointer;" @onclick="ToggleBirthSort">
                    Doğum (Yaş)
                    @if (birthAsc is true)
                    {
                        <span style="font-size: 0.85rem;"> ▲</span>
                    }
                    else if (birthAsc is false)
                    {
                        <span style="font-size: 0.85rem;"> ▼</span>
                    }
                </MudTh>
                <MudTh Style="font-weight:700; color:#475569;">Kayıtlanma Tarihi</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Ad Soyad">
                    <MudLink Href="@($"/hastalar/{context.Id}")"><b>@context.Ad @context.Soyad</b></MudLink>
                </MudTd>
                <MudTd DataLabel="Cinsiyet">
                    @(context.Cinsiyet == "E" ? "Erkek" : context.Cinsiyet == "K" ? "Kadın" : "-")
                </MudTd>
                <MudTd DataLabel="Doğum (Yaş)">
                    @(context.BirthDate?.ToString("dd.MM.yyyy") ?? "-")
                    @if (context.BirthDate is not null)
                    {
                        <span style="color: #64748b;"> (@AgePretty(context.BirthDate.Value))</span>
                    }
                </MudTd>
                <MudTd DataLabel="Kayıtlanma Tarihi">
                    @context.KayitTarihi.ToString("dd.MM.yyyy")
                </MudTd>
            </RowTemplate>
        </MudTable>

        <MudStack Row="true"
          AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween"
          Class="mt-5 px-4"
          Spacing="2">

            <MudText Typo="Typo.body2" Style="color:#64748b; font-weight:500;">
                Toplam: <b style="color:#111827;">@data.Total</b> kayıt bulundu.
            </MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="@(_page <= 1)"
                           OnClick="Prev">
                    Önceki
                </MudButton>

                <MudText Typo="Typo.subtitle2" Style="font-weight:600; color:#475569; min-width:100px; text-align:center;">
                    Sayfa @_page / @TotalPages
                </MudText>

                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Disabled="@(_page >= TotalPages)"
                           OnClick="Next">
                    Sonraki
                </MudButton>
            </MudStack>
        </MudStack>
    }
</div>

@code {
    string q = "";
    bool loading;
    string error = "";

    int _page = 1;
    int _pageSize = 25;

    bool? birthAsc = null;
    string? currentSort = "kayittarihi";

    PagedResult<PatientListDto> data = new() { Items = new() };

    int TotalPages => Math.Max(1, (int)Math.Ceiling((double)(data.Total) / Math.Max(1, _pageSize)));

    protected override async Task OnInitializedAsync()
    {
        if (!LoginState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await Load();
    }
    CancellationTokenSource? _searchCts;

    // Yeni Eklenen Gecikmeli Arama Metodu (Debounce)
    async Task OnSearchChanged(string value)
    {
        q = value ?? "";

        if (string.IsNullOrWhiteSpace(q) || q.Trim().Length < 2)
        {
            _page = 1;
            await Load();
            return;
        }

        _searchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _searchCts = cts;

        try
        {
            await Task.Delay(300, cts.Token);
            _page = 1;
            await Load();
        }
        catch (TaskCanceledException) { }
    }

    async Task Load()
    {
        loading = true; error = "";
        try
        {
            data = await Api.GetPatientsPagedAsync(
                _page, _pageSize, q ?? "", currentSort, birthAsc ?? true);

            if (data.Items is null) data.Items = new();
            if (data.Total == 0) data.Total = data.Items.Count;
        }
        catch (Exception ex)
        {
            error = ex.Message;
            data = new() { Items = new(), Page = _page, PageSize = _pageSize, Total = 0 };
        }
        finally { loading = false; }
    }

    async Task ToggleBirthSort()
    {
        if (birthAsc is null)
            birthAsc = true;
        else
            birthAsc = !birthAsc;

        currentSort = "birthdate";
        _page = 1;
        await Load();
    }

    string AgePretty(DateTime birth)
    {
        var today = DateTime.Today;
        int y = today.Year - birth.Year;
        int m = today.Month - birth.Month;
        int d = today.Day - birth.Day;
        if (d < 0) { m--; var prev = today.AddMonths(-1); d += DateTime.DaysInMonth(prev.Year, prev.Month); }
        if (m < 0) { y--; m += 12; }
        return $"{y}y {m}ay {d}g";
    }

    async Task Search() { _page = 1; await Load(); }
    async Task Prev() { if (_page > 1) { _page--; await Load(); } }
    async Task Next() { if (_page < TotalPages) { _page++; await Load(); } }

    void GoDetail(int id) => Nav.NavigateTo($"/hastalar/{id}");
}