@page "/ziyaretler/{ziyaretId:int}"
@inject HastaTakip.UI.Services.LoginStateService LoginState
@using HastaTakip.UI.Dtos
@using MudBlazor
@inject HastaTakip.UI.Services.HastaApi Api
@inject NavigationManager Nav
@rendermode InteractiveServer
@inject HttpClient Http
@inject IJSRuntime JS

<MudStack Row="true"
          AlignItems="AlignItems.Center"
          Justify="Justify.SpaceBetween"
          Class="mb-4">

    <MudText Typo="Typo.h5" Style="font-weight:700;">
        Ziyaret Detay
    </MudText>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Default"
               OnClick="GeriHasta"
               Size="Size.Small">
        Geri
    </MudButton>

</MudStack>

@if (loading)
{
    <div class="d-flex justify-center my-4">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    </div>
}
else if (!string.IsNullOrEmpty(error))
{
    <MudAlert Severity="Severity.Error" Elevation="0" Dense="true">@error</MudAlert>
}
else if (bundle is null)
{
    <MudText Color="Color.Secondary">Kayıt bulunamadı.</MudText>
}
else
{
    <!--  ZİYARET-->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">

        <MudStack Row="true"
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween"
                  Class="mb-3">

            <MudText Typo="Typo.h6" Style="font-weight:700;">
                Ziyaret
            </MudText>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       OnClick="ToggleEditVisit">
                @(editVisit ? "İptal" : "Düzenle")
            </MudButton>

        </MudStack>

        @if (!editVisit)
        {
            <MudGrid Spacing="2" Class="mb-2">
                <MudItem xs="12" sm="4">
                    <MudText><b>Hasta:</b> @(string.IsNullOrWhiteSpace(bundle?.Ziyaret?.HastaAd) ? "-" : $"{bundle!.Ziyaret.HastaAd} {bundle!.Ziyaret.HastaSoyad}")</MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText><b>Doğum Tarihi:</b> @(bundle!.Ziyaret.BirthDate?.ToString("dd.MM.yyyy") ?? "-")</MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText><b>Cinsiyet:</b> @SexText</MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText><b>Ziyaret Tarihi:</b> @(bundle!.Ziyaret.Tarih?.ToString("dd.MM.yyyy") ?? "-")</MudText>
                </MudItem>

                <MudItem xs="12" sm="4">
                    <MudText><b>Ziyaret Yaşı:</b> @AgeYagText(bundle!.Ziyaret.BirthDate, bundle!.Ziyaret.Tarih)</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mt-2">
                        <b>Yakınmalar:</b>
                        @(string.IsNullOrWhiteSpace(bundle!.Ziyaret.YakinmalarZiyaret) ? "-" : bundle!.Ziyaret.YakinmalarZiyaret)
                    </MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudText Typo="Typo.body2" Class="mt-1">
                        <b>Notlar:</b>
                        @(string.IsNullOrWhiteSpace(bundle!.Ziyaret.Notlar) ? "-" : bundle!.Ziyaret.Notlar)
                    </MudText>
                </MudItem>
            </MudGrid>
        }
        else
        {
            <MudPaper Class="pa-3 mt-2" Elevation="0" Outlined="true">
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="6">
                        <MudDatePicker Label="Ziyaret Tarihi"
                                       Date="@visitEdit.Tarih"
                                       DateChanged="@(d => visitEdit.Tarih = d)"
                                       DateFormat="dd.MM.yyyy"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Clearable="true" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="visitEdit.Notlar"
                                      Label="Notlar"
                                      Lines="2"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField @bind-Value="visitEdit.YakinmalarZiyaret"
                                      Label="Yakınmalar"
                                      Lines="3"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      FullWidth="true" />
                    </MudItem>
                </MudGrid>

                <MudStack Row="true"
                          AlignItems="AlignItems.Center"
                          Spacing="2"
                          Class="mt-3">

                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               OnClick="SaveVisitEdit">
                        Kaydet
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               OnClick="ToggleEditVisit">
                        Vazgeç
                    </MudButton>

                    @if (!string.IsNullOrWhiteSpace(visitError))
                    {
                        <MudText Color="Color.Error">@visitError</MudText>
                    }

                </MudStack>
            </MudPaper>
        }
    </MudPaper>

    <!-- ANTROPOMETRİ  -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6" Style="font-weight:700;">Antropometri</MudText>

            @if (bundle?.Antropometri is not null && LoginState.IsDoctor)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="ToggleEditAnthro">
                    @(editAnthro ? "İptal" : "Düzenle")
                </MudButton>
            }
        </MudStack>

        @if (bundle?.Antropometri is null)
        {
            <MudText Color="Color.Secondary">Kayıt yok.</MudText>

            @if (LoginState.IsDoctor)
            {
                <MudPaper Class="pa-3 mt-3" Elevation="0" Outlined="true">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Antropometri Ekle</MudText>

                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="antAdd.BoyCm"
                                             Label="Boy (cm)"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Step="0.01M" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="antAdd.KiloKg"
                                             Label="Kilo (kg)"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Step="0.01M" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="antAdd.BasCevresiCm"
                                             Label="Baş çev. (cm)"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Step="0.01M" />
                        </MudItem>

                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="antAdd.OturmaBoyuCm"
                                             Label="Oturma boyu (cm)"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Step="0.01M" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAnthro">Kaydet</MudButton>
                        <MudText Color="Color.Error">@antError</MudText>
                    </MudStack>
                </MudPaper>
            }
        }
        else
        {
            @if (!editAnthro)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="3"><MudText><b>Boy (cm):</b> @bundle.Antropometri.BoyCm</MudText></MudItem>
                    <MudItem xs="12" sm="3"><MudText><b>Kilo (kg):</b> @bundle.Antropometri.KiloKg</MudText></MudItem>
                    <MudItem xs="12" sm="3"><MudText><b>BKI:</b> @bundle.Antropometri.BKI</MudText></MudItem>
                    <MudItem xs="12" sm="3"><MudText><b>Baş çev. (cm):</b> @bundle.Antropometri.BasCevresiCm</MudText></MudItem>

                    <MudItem xs="12" sm="3"><MudText><b>Boy SDS:</b> @bundle.Antropometri.BoySDS</MudText></MudItem>
                    <MudItem xs="12" sm="3"><MudText><b>Kilo SDS:</b> @bundle.Antropometri.KiloSDS</MudText></MudItem>
                    <MudItem xs="12" sm="3"><MudText><b>BKI SDS:</b> @bundle.Antropometri.BKISDS</MudText></MudItem>
                    <MudItem xs="12" sm="3"><MudText><b>Baş çev. SDS:</b> @bundle.Antropometri.BasCevresiSDS</MudText></MudItem>
                </MudGrid>
            }
            else
            {
                <MudPaper Class="pa-3 mt-2" Elevation="0" Outlined="true">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="antEdit.BoyCm"
                                             Label="Boy (cm)"
                                             Variant="Variant.Outlined"
                                             Step="0.1M" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="antEdit.KiloKg"
                                             Label="Kilo (kg)"
                                             Variant="Variant.Outlined"
                                             Step="0.1M" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="antEdit.BasCevresiCm"
                                             Label="Baş çev. (cm)"
                                             Variant="Variant.Outlined"
                                             Step="0.1M" />
                        </MudItem>
                        <MudItem xs="12" sm="3">
                            <MudNumericField T="decimal?"
                                             @bind-Value="antEdit.OturmaBoyuCm"
                                             Label="Oturma boyu (cm)"
                                             Variant="Variant.Outlined"
                                             Step="0.1M" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveAnthroEdit">Kaydet</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ToggleEditAnthro">Vazgeç</MudButton>
                        <MudText Color="Color.Error">@antError</MudText>
                    </MudStack>
                </MudPaper>
            }
        }
    </MudPaper>

    <!-- PUBERTE FİZİK -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6" Style="font-weight:700;">Puberte Fizik</MudText>
            @if (bundle?.Puberte is not null && LoginState.IsDoctor)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="ToggleEditPub">
                    @(editPub ? "İptal" : "Düzenle")
                </MudButton>
            }
        </MudStack>

        @if (bundle?.Puberte is null)
        {
            <MudText Color="Color.Secondary">Kayıt yok.</MudText>

            @if (LoginState.IsDoctor)
            {
                <MudPaper Class="pa-3 mt-3" Elevation="0" Outlined="true">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="pubCreate.PuberteNotu" Label="Puberte Notu" Lines="4" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="pubCreate.PatolojikFizik" Label="Patolojik Fizik" Lines="4" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAddPub">Kaydet</MudButton>
                        <MudText Color="Color.Error">@pubError</MudText>
                    </MudStack>
                </MudPaper>
            }
        }
        else
        {
            @if (!editPub)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12"><MudText><b>Puberte Notu:</b> @bundle.Puberte.PuberteNotu</MudText></MudItem>
                    <MudItem xs="12"><MudText><b>Patolojik Fizik:</b> @bundle.Puberte.PatolojikFizik</MudText></MudItem>
                </MudGrid>
            }
            else
            {
                <MudPaper Class="pa-3 mt-2" Elevation="0" Outlined="true">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="pubEdit.PuberteNotu" Label="Puberte Notu" Lines="4" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="pubEdit.PatolojikFizik" Label="Patolojik Fizik" Lines="4" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEditPub">Kaydet</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ToggleEditPub">Vazgeç</MudButton>
                        <MudText Color="Color.Error">@pubError</MudText>
                    </MudStack>
                </MudPaper>
            }
        }
    </MudPaper>

    <!-- YORUM / PLAN -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6" Style="font-weight:700;">Yorum / Plan</MudText>
            @if (bundle?.YorumPlan is not null && LoginState.IsDoctor)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="ToggleEditYp">
                    @(editYp ? "İptal" : "Düzenle")
                </MudButton>
            }
        </MudStack>

        @if (bundle?.YorumPlan is null)
        {
            <MudText Color="Color.Secondary">Kayıt yok.</MudText>

            @if (LoginState.IsDoctor)
            {
                <MudPaper Class="pa-3 mt-3" Elevation="0" Outlined="true">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="ypCreate.TedaviBeslenmeSpor" Label="Tedavi/Beslenme/Spor" Lines="4" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="ypCreate.YorumNotlar" Label="Notlar" Lines="4" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAddYp">Kaydet</MudButton>
                        <MudText Color="Color.Error">@ypError</MudText>
                    </MudStack>
                </MudPaper>
            }
        }
        else
        {
            @if (!editYp)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12"><MudText><b>Tedavi/Beslenme/Spor:</b> @bundle.YorumPlan.TedaviBeslenmeSpor</MudText></MudItem>
                    <MudItem xs="12"><MudText><b>Notlar:</b> @bundle.YorumPlan.YorumNotlar</MudText></MudItem>
                    <MudItem xs="12"><MudText><b>Oluşturma:</b> @(bundle.YorumPlan.OlusturmaTarihi is { } yt ? $"{yt:dd.MM.yyyy HH:mm}" : "-")</MudText></MudItem>
                </MudGrid>
            }
            else
            {
                <MudPaper Class="pa-3 mt-2" Elevation="0" Outlined="true">
                    <MudGrid Spacing="2">
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="ypEdit.TedaviBeslenmeSpor" Label="Tedavi/Beslenme/Spor" Lines="4" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="ypEdit.YorumNotlar" Label="Notlar" Lines="4" Variant="Variant.Outlined" FullWidth="true" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveEditYp">Kaydet</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ToggleEditYp">Vazgeç</MudButton>
                        <MudText Color="Color.Error">@ypError</MudText>
                    </MudStack>
                </MudPaper>
            }
        }
    </MudPaper>

    <!--  KLİNİK ÖZET  -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6" Style="font-weight:700;">Klinik Özet</MudText>
            @if (bundle?.Ozet is not null && LoginState.IsDoctor)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="ToggleEditOzet">
                    @(editOzet ? "İptal" : "Düzenle")
                </MudButton>
            }
        </MudStack>

        @if (bundle?.Ozet is null)
        {
            <MudText Color="Color.Secondary">Kayıt yok.</MudText>

            @if (LoginState.IsDoctor)
            {
                <MudPaper Class="pa-3 mt-3" Elevation="0" Outlined="true">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal?"
                                             @bind-Value="ozetCreate.KulacCm"
                                             Label="Kulaç (cm)"
                                             Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal?"
                                             @bind-Value="ozetCreate.HedefBoyCm"
                                             Label="Hedef Boy (cm)"
                                             Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" @bind-Value="ozetCreate.BoyaUyanTarti" Label="Boy’a Uyan Tartı" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAddOzet">Kaydet</MudButton>
                        <MudText Color="Color.Error">@ozetError</MudText>
                    </MudStack>
                </MudPaper>
            }
        }
        else
        {
            @if (!editOzet)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12" sm="4"><MudText><b>Kulaç (cm):</b> @bundle.Ozet.KulacCm</MudText></MudItem>
                    <MudItem xs="12" sm="4"><MudText><b>Hedef Boy (cm):</b> @bundle.Ozet.HedefBoyCm</MudText></MudItem>
                    <MudItem xs="12" sm="4"><MudText><b>Boy’a Uyan Tartı:</b> @bundle.Ozet.BoyaUyanTarti</MudText></MudItem>
                </MudGrid>
            }
            else
            {
                <MudPaper Class="pa-3 mt-2" Elevation="0" Outlined="true">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal?"
                                             @bind-Value="ozetEdit.KulacCm"
                                             Label="Kulaç (cm)"
                                             Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal?"
                                             @bind-Value="ozetEdit.HedefBoyCm"
                                             Label="Hedef Boy (cm)"
                                             Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField T="string" @bind-Value="ozetEdit.BoyaUyanTarti" Label="Boy’a Uyan Tartı" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>

                    <MudStack Row="true" Spacing="2" Class="mt-3">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveEditOzet">Kaydet</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="ToggleEditOzet">Vazgeç</MudButton>
                        <MudText Color="Color.Error">@ozetError</MudText>
                    </MudStack>
                </MudPaper>
            }
        }
    </MudPaper>

    <MudStack Row="true" Spacing="2" Class="mb-4">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => OpenChartPopup(ziyaretId)">Grafik Göster</MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="OpenLab">Laboratuvar Sonuçları</MudButton>
    </MudStack>
}
@code {
    [Parameter] public int ziyaretId { get; set; }

    bool loading; string? error;
    ZiyaretBundleDto? bundle;
    List<AntropometriListDto> anthros = new();

    AntropometriCreateDto antAdd = new();
    AntropometriUpdateDto antEdit = new();
    bool editAnthro; string? antError;

    PuberteFizikCreateDto pubCreate = new();
    PuberteFizikUpdateDto pubEdit = new();
    bool editPub; string? pubError;

    YorumPlanCreateDto ypCreate = new();
    YorumPlanUpdateDto ypEdit = new();
    bool editYp; string? ypError;

    OzetHesapCreateDto ozetCreate = new();
    OzetHesapUpdateDto ozetEdit = new();
    bool editOzet; string? ozetError;

    
    ZiyaretUpdateDto visitEdit = new();
    bool editVisit; string? visitError;

    
    char _sexChar = 'E';
    string SexText => _sexChar == 'K' ? "Kadın" : "Erkek";

    
    string AgeYagText(DateTime? birth, DateTime? refDate)
    {
        if (birth is null || refDate is null) return "-";
        var (y, a, g) = AgeYag(birth.Value, refDate.Value);
        return $"{y} yıl {a} ay {g} gün";
    }

    static (int yil, int ay, int gun) AgeYag(DateTime birth, DateTime refDate)
    {
        if (refDate < birth) return (0, 0, 0);
        int y = refDate.Year - birth.Year;
        int a = refDate.Month - birth.Month;
        int g = refDate.Day - birth.Day;
        if (g < 0)
        {
            var prevMonth = refDate.AddMonths(-1);
            g += DateTime.DaysInMonth(prevMonth.Year, prevMonth.Month);
            a -= 1;
        }
        if (a < 0)
        {
            a += 12;
            y -= 1;
        }
        return (y, a, g);
    }



    protected override async Task OnParametersSetAsync()
    {
        if (!LoginState.IsLoggedIn)
        {
            Nav.NavigateTo("/login");
            return;
        }

        await LoadVisit();
    }

    void OpenCharts()
    {
        
        Nav.NavigateTo($"/ziyaretler/{ziyaretId}/grafik");
    }


    async Task LoadVisit()
    {
        loading = true;
        error = null;

        try
        {
            
            bundle = await Api.GetZiyaretBundleAsync(ziyaretId);

            
            if (bundle?.Antropometri is not null)
            {
                antEdit = new()
                {
                    BoyCm = bundle.Antropometri.BoyCm,
                    KiloKg = bundle.Antropometri.KiloKg,
                    BasCevresiCm = bundle.Antropometri.BasCevresiCm,
                    OturmaBoyuCm = bundle.Antropometri.OturmaBoyuCm
                };
            }
            else
            {
                antEdit = new(); 
            }

            if (bundle?.Puberte is not null)
            {
